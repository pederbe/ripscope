// Cloudflare Workers Builds deploys website-input changes on main to ripscope.com.
// Build watch paths are configured in the Worker's production build settings.
{
  "$schema": "./tools/site/node_modules/wrangler/config-schema.json",
  "name": "ripscope-site",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./target/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ripscope.com", "custom_domain": true }]
}
