(ert-deftest ripscope-pipeline-failures-and-database-options ()
  :tags '(linux)
  (ripscope-test-project
   (should (= (car (ripscope-test-build root)) 0))
   (let ((index (ripscope-test-bytes "cscope.out"))
         (helpers (make-temp-file "/tmp/ripscope-helpers-" t)))
     (unwind-protect
         (dolist (name '("find" "sed"))
           (let ((path (expand-file-name name helpers)))
             (with-temp-file path (insert "#!/bin/sh\necho injected-helper-failure >&2\nexit 7\n"))
             (set-file-modes path #o700)
             (let ((process-environment (cons (concat "PATH=" helpers ":" (getenv "PATH")) process-environment))
                   (exec-path (cons helpers exec-path)))
               (let ((result (ripscope-test-build root)))
                 (should-not (= (car result) 0))
                 (should (string-match-p "injected-helper-failure" (cadr result)))
                 (should-not (string-match-p "Indexing finished" (cadr result)))))
             (should (equal index (ripscope-test-bytes "cscope.out")))
             (delete-file path)))
       (delete-directory helpers t)))
   (should (= (car (ripscope-test-build root)) 0))
   ;; `-q` asks for cscope's inverted index, which ripscope always has.
   (let ((cscope-database-regexps `((".*" (,root ("-q"))))))
     (ripscope-test-query root 'cscope-find-global-definition "callee")
     (should (ripscope-test-match)))
   (let ((cscope-option-other '("-q")) (cscope-option-kernel-mode t))
     (ripscope-test-query root 'cscope-find-global-definition "callee")
     (should (ripscope-test-match)))))

(ert-deftest ripscope-pinned-source-and-loaded-copy-guards ()
  (let* ((adapter (getenv "RIPSCOPE_EMACS_ADAPTER"))
         (vendor (expand-file-name "vendor/xcscope.el" (file-name-directory adapter)))
         (emacs (expand-file-name invocation-name invocation-directory))
         (copy (make-temp-file "ripscope-pin-" t)))
    (unwind-protect
        (progn
          (make-directory (expand-file-name "vendor" copy))
          (copy-file adapter (expand-file-name "ripscope-xcscope.el" copy))
          (with-temp-file (expand-file-name "vendor/xcscope.el" copy)
            (insert "(error \"unverified source executed\")"))
          (dolist (case `(((load ,vendor nil t) (load ,adapter nil t))
                          ((load ,(expand-file-name "ripscope-xcscope.el" copy) nil t))))
            (with-temp-buffer
              (should-not (= 0 (call-process emacs nil t nil "-Q" "--batch" "--eval"
                                            (prin1-to-string `(progn ,@case)))))
              (should (string-match-p "Load ripscope-xcscope before\\|Pinned xcscope source hash mismatch" (buffer-string)))
              (should-not (string-match-p "unverified source executed" (buffer-string))))))
      (delete-directory copy t))))

(ert-deftest ripscope-failed-older-rerun-keeps-history-attribution ()
  :tags '(linux)
  (ripscope-test-project
   (should (= (car (ripscope-test-build root)) 0))
   (ripscope-test-query root 'cscope-find-global-definition "callee")
   (ripscope-test-query root 'cscope-find-global-definition "caller")
   (let ((fake (make-temp-file "/tmp/ripscope-rerun-backend-")))
     (unwind-protect
         (progn
           (with-temp-file fake (insert "#!/bin/sh\nprintf older-diagnostic >&2\nexit 7\n"))
           (set-file-modes fake #o700)
           (let ((cscope-program fake) (ripscope-xcscope--backend fake))
             (with-current-buffer cscope-output-buffer-name
               (goto-char (point-min))
               (search-forward "Finding global definition: callee")
               (cscope-rerun-search-at-point)
               (ripscope-test-wait 'cscope-process)
               (let* ((text (buffer-string))
                      (older (string-match "older-diagnostic" text))
                      (failure (string-match "Ripscope search failed" text))
                      (newer (string-match "Finding global definition: caller" text)))
                 (should older) (should failure) (should newer)
                 (should (< older failure))
                 (should (< failure newer))
                 (should (string-match-p "Search complete" (substring text newer)))))))
       (delete-file fake)))))

(ert-deftest ripscope-remote-databases-are-refused-before-file-access ()
  (ripscope-test-project
   (let ((cscope-database-regexps '((".*" ("/ssh:example:/project/"))))
         (regular-p (symbol-function 'file-regular-p)))
     (cl-letf (((symbol-function 'file-regular-p)
                (lambda (file)
                  (when (file-remote-p file) (ert-fail "Accessed a remote database"))
                  (funcall regular-p file))))
       (should-error (cscope-find-global-definition "value") :type 'user-error)))))

(ert-deftest ripscope-relative-project-root-is-resolved-once ()
  (ripscope-test-project
   (let ((default-directory (file-name-directory root)))
     (should (= (car (ripscope-test-build (file-name-nondirectory root))) 0)))
   (ripscope-test-query root 'cscope-find-global-definition "callee")
   (should (ripscope-test-match))))

