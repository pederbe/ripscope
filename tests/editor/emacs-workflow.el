;;; emacs-workflow.el --- Real Emacs/Ripscope workflow tests -*- lexical-binding: t; no-byte-compile: t -*-
(require 'ert)
(require 'cl-lib)
(require 'json)
(load (getenv "RIPSCOPE_EMACS_ADAPTER") nil t)
(let* ((raw (getenv "RIPSCOPE_EMACS_BACKEND"))
       (backend (if (eq system-type 'windows-nt)
                    ;; getenv has decoded the inherited bytes with the locale,
                    ;; which can differ from Windows' ANSI code page.
                    (decode-coding-string (if (multibyte-string-p raw)
                                              (encode-coding-string raw locale-coding-system)
                                            raw)
                                          (if (= w32-ansi-code-page 65001) 'utf-8
                                            (intern (format "cp%d" w32-ansi-code-page))))
                  raw)))
  ;; Keep the individual setup predicates when validation stops before ERT.
  (princ
   (concat "BACKEND_SETUP "
           (json-encode
            `((path . ,backend)
              (raw_characters . ,(vconcat (string-to-list raw)))
              (ansi_code_page . ,(and (boundp 'w32-ansi-code-page) w32-ansi-code-page))
              (characters . ,(vconcat (string-to-list backend)))
              (absolute . ,(if (file-name-absolute-p backend) t :json-false))
              (local . ,(if (file-remote-p backend) :json-false t))
              (executable . ,(if (file-executable-p backend) t :json-false))
              (non_directory . ,(if (file-directory-p backend) :json-false t))
              (exe_suffix . ,(if (string-suffix-p ".exe" (downcase backend)) t :json-false))
              (exists . ,(if (file-exists-p backend) t :json-false))
              (expanded . ,(expand-file-name backend))
              (file_name_coding . ,(format "%S" file-name-coding-system))
              (locale_coding . ,(format "%S" locale-coding-system))))
           "\n"))
  (ripscope-xcscope-setup backend))
(setq cscope-display-times nil cscope-edit-single-match nil vc-handled-backends nil)
(defvar ripscope-test-sessions nil)

(defun ripscope-test-live-sessions ()
  (let (processes)
    (maphash (lambda (_ session)
               (let ((process (ripscope-xcscope--session-process session)))
                 (when (process-live-p process) (push process processes))))
             ripscope-xcscope--sessions)
    processes))

(defun ripscope-test-wait (variable)
  (let ((deadline (+ (float-time) 15)))
    (while (and (symbol-value variable) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should-not (symbol-value variable))))

(defun ripscope-test-build (root)
  (cscope-index-files root)
  (let ((process cscope-unix-index-process))
    (ripscope-test-wait 'cscope-unix-index-process)
    (princ (with-current-buffer "*cscope-indexing-buffer*" (buffer-string)))
    (list (process-exit-status process)
          (with-current-buffer "*cscope-indexing-buffer*" (buffer-string)))))

(defun ripscope-test-query (root command pattern)
  (with-current-buffer (find-file-noselect (expand-file-name "case.c" root))
    (funcall command pattern))
  (with-current-buffer cscope-output-buffer-name
    (let ((process cscope-process))
      (ripscope-test-wait 'cscope-process)
      (when process (should-not (process-live-p process))))
    (dolist (session (ripscope-test-live-sessions))
      (push (list (process-id session) (process-command session)) ripscope-test-sessions))
    (buffer-substring cscope-output-start (point-max))))

(defun ripscope-test-match ()
  (with-current-buffer cscope-output-buffer-name cscope-first-match-point))

(defun ripscope-test-bytes (file)
  (with-temp-buffer (insert-file-contents-literally file) (buffer-string)))

(defun ripscope-test-jump (root command pattern file line shown)
  (let ((text (ripscope-test-query root command pattern)))
    (should (string-match-p "Search complete" text))
    (should (string-match-p shown text))
    (should (ripscope-test-match))
    (with-current-buffer cscope-output-buffer-name
      (let* ((props (cscope-get-navigation-properties cscope-first-match-point))
             (window (cscope-show-entry-internal props)))
        (should (equal (file-truename (buffer-file-name (window-buffer window)))
                       (file-truename (expand-file-name file root))))
        (with-current-buffer (window-buffer window)
          (should (= (line-number-at-pos (window-point window)) line))
          (goto-char (window-point window))
          (should (string-match-p shown (buffer-substring (line-beginning-position) (line-end-position)))))))))

(defmacro ripscope-test-project (&rest body)
  `(let* ((root (make-temp-file (if (eq system-type 'windows-nt)
                                   "ripscope-emacs & % é-" "ripscope-emacs-") t))
          (default-directory (file-name-as-directory root))
          (cscope-initial-directory default-directory)
          (cscope-database-regexps nil)
          (cscope-index-recursively t))
     (unwind-protect
         (progn
           (with-temp-file (expand-file-name "case.h" root) (insert "extern int value;\n"))
           (with-temp-file (expand-file-name "case.c" root)
             (insert "#include \"case.h\"\nint value;\nint callee(void) { return value; }\nint caller(void) { value = 7; return callee(); }\n"))
           ,@body)
       (dolist (buffer (buffer-list))
         (when (and (buffer-file-name buffer)
                    (string-prefix-p root (buffer-file-name buffer)))
           (kill-buffer buffer)))
       (when (get-buffer cscope-output-buffer-name) (kill-buffer cscope-output-buffer-name))
       ;; Windows keeps a running session's directory from being removed.
       (ripscope-xcscope-stop-sessions)
       (delete-directory root t))))

(ert-deftest ripscope-saved-and-external-changes-refresh-in-one-session ()
  (ripscope-test-project
   (should (= (car (ripscope-test-build root)) 0))
   (let ((selection (and (file-exists-p "cscope.files") (ripscope-test-bytes "cscope.files")))
         (ripscope-test-sessions nil))
     (ripscope-test-jump root 'cscope-find-global-definition "callee" "case.c" 3 "callee")
     (with-current-buffer (find-file-noselect (expand-file-name "case.c" root))
       (erase-buffer)
       (insert "#include \"case.h\"\nint Saved;\nvoid changed(void) { target(); }\n")
       (save-buffer))
     (ripscope-test-jump root 'cscope-find-global-definition "Saved" "case.c" 2 "Saved")
     (ripscope-test-jump root 'cscope-find-functions-calling-this-function "target" "case.c" 3 "changed")
     (with-temp-file "case.c" (insert "#include \"case.h\"\nint Saved;\nvoid changed(void) { target(); }\nint Outside;\n"))
     (with-current-buffer (get-file-buffer (expand-file-name "case.c" root)) (revert-buffer t t))
     (ripscope-test-jump root 'cscope-find-global-definition "Outside" "case.c" 4 "Outside")
     (with-temp-file "case.h" (insert "int HeaderFresh;\n"))
     (ripscope-test-jump root 'cscope-find-global-definition "HeaderFresh" "case.h" 1 "HeaderFresh")
     (when selection (should (equal selection (ripscope-test-bytes "cscope.files"))))
     (with-temp-file "added.c" (insert "int Added;\n"))
     (when selection
       (ripscope-test-query root 'cscope-find-global-definition "Added")
       (should-not (ripscope-test-match))
       (should (equal selection (ripscope-test-bytes "cscope.files")))
       (with-temp-buffer (insert selection "added.c\n") (write-region (point-min) (point-max) "cscope.files" nil 'quiet)))
     (ripscope-test-jump root 'cscope-find-global-definition "Added" "added.c" 1 "Added")
     (rename-file "added.c" "renamed.c")
     (when selection
       (with-temp-buffer (insert selection "renamed.c\n") (write-region (point-min) (point-max) "cscope.files" nil 'quiet)))
     (ripscope-test-jump root 'cscope-find-global-definition "Added" "renamed.c" 1 "Added")
     (delete-file "renamed.c")
     (when selection
       (with-temp-buffer (insert selection) (write-region (point-min) (point-max) "cscope.files" nil 'quiet)))
     (ripscope-test-query root 'cscope-find-global-definition "Added")
     (should-not (ripscope-test-match))
     ;; Every search went to one session, which refreshed on its own.
     (should (> (length ripscope-test-sessions) 5))
     (princ (concat "AUTO_QUERY_SESSIONS " (json-encode (vconcat ripscope-test-sessions)) "\n"))
     (should (= (length (delete-dups (mapcar #'car ripscope-test-sessions))) 1))
     (dolist (session ripscope-test-sessions)
       (should (member "--json" (cadr session)))
       (should (member "-l" (cadr session)))
       (should-not (member "-L" (cadr session)))
       (should (member "--auto-refresh" (cadr session))))
     ;; A stopped session gives way to a new one at the next search.
     (ripscope-xcscope-stop-sessions)
     (should-not (ripscope-test-live-sessions))
     (ripscope-test-jump root 'cscope-find-global-definition "Saved" "case.c" 2 "Saved")
     (should (= (length (ripscope-test-live-sessions)) 1)))))

(ert-deftest ripscope-manual-refresh-keeps-saved-facts-until-explicit-build ()
  (let ((ripscope-xcscope-auto-refresh nil))
    (ripscope-test-project
     (should (= (car (ripscope-test-build root)) 0))
     (with-current-buffer (find-file-noselect (expand-file-name "case.c" root))
       (goto-char (point-max)) (insert "int ManualSaved;\n") (save-buffer))
     (ripscope-test-query root 'cscope-find-global-definition "ManualSaved")
     (should-not (ripscope-test-match))
     (should (= (car (ripscope-test-build root)) 0))
     (ripscope-test-jump root 'cscope-find-global-definition "ManualSaved" "case.c" 5 "ManualSaved"))))

(ert-deftest ripscope-all-nine-searches-and-jumps ()
  (ripscope-test-project
   (should (= (car (ripscope-test-build root)) 0))
   (dolist (case '((cscope-find-this-symbol "value" 2)
                   (cscope-find-global-definition "callee" 3)
                   (cscope-find-called-functions "caller" 4)
                   (cscope-find-functions-calling-this-function "callee" 4)
                   (cscope-find-this-text-string "value = 7" 4)
                   (cscope-find-egrep-pattern "value.*7" 4)
                   (cscope-find-this-file "case.c" 1)
                   (cscope-find-files-including-file "case.h" 1)
                   (cscope-find-assignments-to-this-symbol "value" 4)))
     (let ((text (ripscope-test-query root (nth 0 case) (nth 1 case))))
       (should (string-match-p "Search complete" text))
       (should (ripscope-test-match))
       (with-current-buffer cscope-output-buffer-name
         (let* ((props (cscope-get-navigation-properties cscope-first-match-point))
                (window (cscope-show-entry-internal props)))
           (should (equal (file-truename (buffer-file-name (window-buffer window)))
                          (file-truename (expand-file-name "case.c" root))))
           (with-current-buffer (window-buffer window)
             (should (= (line-number-at-pos (window-point window)) (nth 2 case))))))))))

(ert-deftest ripscope-large-answers-and-overlapping-searches ()
  (ripscope-test-project
   ;; More rows than xcscope's line matching takes in one piece.
   (with-temp-file "many.c"
     (dotimes (n 2500) (insert (format "int many%d(void) { return value; }\n" n))))
   (should (= (car (ripscope-test-build root)) 0))
   (let ((text (ripscope-test-query root 'cscope-find-this-symbol "value")))
     (should (string-match-p "Search complete" text))
     (should (string-match-p "many2499" text))
     (should (ripscope-test-match)))
   ;; A second search while one runs is refused, and the first keeps its answer.
   (let ((source (find-file-noselect (expand-file-name "case.c" root))))
     (with-current-buffer source (cscope-find-global-definition "callee"))
     ;; xcscope itself refuses it only from its own buffer.
     (with-current-buffer source
       (should-error (cscope-find-global-definition "caller") :type 'user-error)))
   (with-current-buffer cscope-output-buffer-name
     (ripscope-test-wait 'cscope-process)
     (let ((text (buffer-substring cscope-output-start (point-max))))
       (should (string-match-p "Search complete" text))
       (should (string-match-p "int callee" text))
       (should-not (string-match-p "int caller" text))))))

(ert-deftest ripscope-build-failure-retry-and-new-definition ()
  :tags '(linux)
  (ripscope-test-project
   (should (= (car (ripscope-test-build root)) 0))
   (let ((index (ripscope-test-bytes "cscope.out"))
         (cscope-program "/bin/false") (ripscope-xcscope--backend "/bin/false"))
     (let ((result (ripscope-test-build root)))
       (should-not (= (car result) 0))
       (should-not (string-match-p "Indexing finished" (cadr result))))
     (should (equal index (ripscope-test-bytes "cscope.out"))))
   (with-temp-file "new.c" (insert "int Added;\n"))
   (should (= (car (ripscope-test-build root)) 0))
   (ripscope-test-query root 'cscope-find-global-definition "Added")
   (should (ripscope-test-match))
   (with-current-buffer cscope-output-buffer-name
     (should (equal (elt (cscope-get-navigation-properties cscope-first-match-point) 0)
                    (expand-file-name "new.c" root))))))

(ert-deftest ripscope-unwritable-build-and-missing-prerequisites ()
  :tags '(linux)
  (ripscope-test-project
   (should (= (car (ripscope-test-build root)) 0))
   (let ((original (ripscope-test-bytes "cscope.files")))
     (let ((exec-path nil))
       (should-error (cscope-index-files root) :type 'user-error))
     (should (equal original (ripscope-test-bytes "cscope.files"))))
   (let ((cscope-program "/missing/ripscope") (ripscope-xcscope--backend "/missing/ripscope"))
     (should-error (cscope-index-files root) :type 'user-error))
   (set-file-modes "cscope.files" #o400)
   (unwind-protect
       (let ((result (ripscope-test-build root)))
         (should-not (= (car result) 0))
         (should-not (string-match-p "Indexing finished" (cadr result))))
     (set-file-modes "cscope.files" #o600))
   (let ((cscope-database-file "blocked/index"))
     (make-directory "blocked")
     (set-file-modes "blocked" #o500)
     (unwind-protect
         (let ((result (ripscope-test-build root)))
           (should-not (= (car result) 0))
           (should-not (string-match-p "Indexing finished" (cadr result))))
       (set-file-modes "blocked" #o700)))
   (should (= (car (ripscope-test-build root)) 0))))

(ert-deftest ripscope-selection-and-include-options ()
  :tags '(linux)
  (ripscope-test-project
   (make-directory "nested") (make-directory ".git") (make-directory "includes")
   (with-temp-file "nested/deep.c" (insert "int Deep;\n"))
   (with-temp-file ".git/ignored.c" (insert "int Ignored;\n"))
   (with-temp-file "includes/external.h" (insert "int External;\n"))
   (with-temp-file "case.c" (insert "#include <external.h>\nint Local;\n"))
   (let ((ripscope-xcscope-include-directories '("includes"))
         (cscope-indexer-ignored-directories '(".git" "includes")))
     (should (= (car (ripscope-test-build root)) 0))
     (ripscope-test-query root 'cscope-find-global-definition "External")
     (should (ripscope-test-match))
     (ripscope-test-query root 'cscope-find-global-definition "Deep")
     (should (ripscope-test-match))
     (ripscope-test-query root 'cscope-find-global-definition "Ignored")
     (should-not (ripscope-test-match))
     (let ((cscope-index-recursively nil))
       (should (= (car (ripscope-test-build root)) 0)))
     (ripscope-test-query root 'cscope-find-global-definition "Deep")
     (should-not (ripscope-test-match)))))

(ert-deftest ripscope-query-failure-and-signal-are-visible ()
  :tags '(linux)
  (ripscope-test-project
   (should (= (car (ripscope-test-build root)) 0))
   (dolist (script '("#!/bin/sh\nprintf 'case.c value 2 int value;\\n'\nprintf tail-without-newline >&2\nexit 7\n"
                     "#!/bin/sh\nprintf 'case.c value 2 int value;\\n'\nprintf signal-tail >&2\nkill -TERM $$\n"))
     (let ((fake (make-temp-file "/tmp/ripscope-failing-backend-")))
       (with-temp-file fake (insert script)) (set-file-modes fake #o700)
       (let* ((cscope-program fake) (ripscope-xcscope--backend fake)
              (text (ripscope-test-query root 'cscope-find-global-definition "value")))
         (should (string-match-p "Ripscope search failed" text))
         (should (string-match-p (if (string-match-p "exit 7" script) "tail-without-newline" "signal-tail") text))
         (should-not (string-match-p "Search complete" text))
         (should-not (ripscope-test-match)))))
   (ripscope-test-query root 'cscope-find-global-definition "callee")
   (should (ripscope-test-match))))

(ert-deftest ripscope-query-diagnostics-and-recovery ()
  (let ((ripscope-xcscope-auto-refresh nil))
   (ripscope-test-project
   (let ((text (ripscope-test-query root 'cscope-find-global-definition "value")))
     (should (string-match-p "Ripscope search failed" text))
     (should-not (string-match-p "Search complete" text)))
   (with-temp-file "cscope.out" (insert "not a Ripscope index"))
   (let ((text (ripscope-test-query root 'cscope-find-global-definition "value")))
     (should (string-match-p "Ripscope search failed" text))
     (should-not (ripscope-test-match)))
   (delete-file "cscope.out")
   (should (= (car (ripscope-test-build root)) 0))
   (let ((text (ripscope-test-query root 'cscope-find-global-definition "Absent")))
     (should (string-match-p "No matches were found" text))
     (should (string-match-p "Search complete" text))
     (should-not (string-match-p "ripscope:" text))
     (should-not (ripscope-test-match)))
   ;; A session answers a pattern it cannot use with an error, shown as a failure.
   (let ((text (ripscope-test-query root 'cscope-find-global-definition "[")))
     (should (string-match-p "invalid query pattern" text))
     (should (string-match-p "Ripscope search failed" text))
     (should-not (string-match-p "Search complete" text))
     (should-not (ripscope-test-match)))
   ;; The session answers again after it.
   (let ((text (ripscope-test-query root 'cscope-find-global-definition "callee")))
     (should (string-match-p "Search complete" text))
     (should (ripscope-test-match)))
   (delete-file "case.h")
   (dolist (pattern '("value" "Absent"))
     (let ((text (ripscope-test-query root 'cscope-find-this-text-string pattern)))
       (should (string-match-p "ripscope: cannot read case.h" text))
       (should (string-match-p "Search complete" text))
       (if (equal pattern "value")
           (with-current-buffer cscope-output-buffer-name
             (should cscope-first-match-point)
             (let* ((props (cscope-get-navigation-properties cscope-first-match-point))
                    (window (cscope-show-entry-internal props)))
               (should (equal (file-truename (buffer-file-name (window-buffer window)))
                              (file-truename (expand-file-name "case.c" root))))
               (with-current-buffer (window-buffer window)
                 (should (= (line-number-at-pos (window-point window)) 2)))))
         (should-not (ripscope-test-match)))))
   (with-temp-file "case.h" (insert "extern int value;\n"))
   (let ((text (ripscope-test-query root 'cscope-find-this-text-string "value")))
     (should (ripscope-test-match))
     (should-not (string-match-p "ripscope:" text)))
   (let ((cscope-database-file "missing-directory/index.db"))
     (let ((result (ripscope-test-build root)))
       (should-not (= (car result) 0))
       (should-not (string-match-p "Indexing finished" (cadr result))))))))

