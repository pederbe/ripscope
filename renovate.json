{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "cargo",
    "npm",
    "github-actions",
    "dockerfile",
    "custom.regex"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/target/**"
  ],
  "rangeStrategy": "bump",
  "ignoreUnstable": true,
  "minimumReleaseAge": "0 days",
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "dependencyDashboard": false,
  "pinDigests": true,
  "automerge": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "commitBody": "Changelog: Dependencies: Update runtime and build dependencies.",
  "prFooter": "Changelog: Dependencies: Update runtime and build dependencies.",
  "packageRules": [
    {
      "description": "Keep the runtime smoke test on the supported glibc 2.28 floor.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/library/debian"],
      "allowedVersions": "/^10$/"
    },
    {
      "matchPackageNames": [
        "*"
      ],
      "groupName": "daily dependencies",
      "groupSlug": "daily-dependencies",
      "separateMajorMinor": false
    },
    {
      "description": "notify 9 rc6 repairs Windows overflow/rescan handling absent from stable 8.2. Promote to stable 9+ when available.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "notify"
      ],
      "allowedVersions": "/^(?:9\\.0\\.0-rc\\.6|(?:9|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+)$/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/(release-plz|release|ci)\\.yml$/"],
      "matchStrings": ["git-cliff@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "git-cliff",
      "packageNameTemplate": "orhun/git-cliff",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^scripts/build-site\\.sh$/"
      ],
      "matchStrings": [
        "--package npm@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "npm",
      "packageNameTemplate": "npm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/dependency-pins\\.json$/"
      ],
      "matchStrings": [
        "\"zigbuild\":\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "cargo-zigbuild",
      "packageNameTemplate": "rust-cross/cargo-zigbuild",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/dependency-pins\\.json$/"],
      "matchStrings": ["\"zig\":\\s*\"(?<currentValue>[^\"\\s]+)\""],
      "depNameTemplate": "zig",
      "packageNameTemplate": "https://codeberg.org/ziglang/zig.git",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/dependency-pins\\.json$/"
      ],
      "matchStrings": [
        "\"mdbook\":\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "mdbook",
      "packageNameTemplate": "rust-lang/mdBook",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tools/release/linux-release-profile\\.json$/"
      ],
      "matchStrings": [
        "\"(?:build_image|runtime_image)\":\\s*\"(?<depName>[^\"@:]+(?:/[^\"@:]*)?):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/dependency-pins\\.json$/"
      ],
      "matchStrings": [
        "\"node\":\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "node",
      "packageNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/dependency-pins\\.json$/"
      ],
      "matchStrings": [
        "\"lychee\":\\s*\"(?<currentValue>[^\"\\s]+)\""
      ],
      "depNameTemplate": "lychee",
      "packageNameTemplate": "lycheeverse/lychee",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^lychee-v(?<version>.+)$"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "bash .github/scripts/renovate-sync.sh"
    ],
    "fileFilters": [
      ".github/**",
      "tools/release/**",
      "tools/site/src/main.rs",
      "scripts/build-site.sh",
      "docs/linux-release.md",
      "docs/windows-release.md",
      "tools/site/README.md"
    ],
    "executionMode": "branch"
  },
  "vulnerabilityAlerts": {
    "vulnerabilityFixStrategy": "highest"
  },
  "automergeType": "pr",
  "platformAutomerge": true
}
